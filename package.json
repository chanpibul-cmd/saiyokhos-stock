{
  "name": "saiyok-hospital-stock",
  "version": "1.0.0",
  "description": "ระบบบริหารคลังและสต๊อกพัสดุ โรงพยาบาลไทรโยค (Sai Yok Hospital Stock Management System)",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create saiyok_stock_db",
    "d1:init-local": "wrangler d1 execute saiyok_stock_db --local --file=./schema.sql",
    "d1:init-remote": "wrangler d1 execute saiyok_stock_db --remote --file=./schema.sql"
  },
  "keywords": [
    "cloudflare-workers",
    "cloudflare-d1",
    "hospital-inventory",
    "stock-management",
    "sai-yok-hospital"
  ],
  "author": "Sai Yok Hospital IT & Antigravity",
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^3.50.0"
  }
}
